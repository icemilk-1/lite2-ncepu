Solid {
  translation -4.0 -3.0 0.33
  name "sensor_lab_fixture"
  children [
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 1
        minStop -0.000001
        maxStop 0.000001
      }
      endPoint DEF LITE2 Lite2Body {
  name "lite2_sensor_lab"
  controller "sensor_capture"
  supervisor TRUE
  customData "F:/airace/lite2_sim/config/sensor_lab.json"
  toolSlot [
    Pose {
      translation 0.22 0.0 0.05
      children [
        Camera {
          name "front_rgb"
          width 424
          height 240
          fieldOfView 1.2222501549001135
          near 0.02
          far 6.0
        }
        RangeFinder {
          name "front_depth"
          width 424
          height 240
          fieldOfView 1.2222501549001135
          near 0.02
          minRange 0.15
          maxRange 6.0
        }
      ]
    }
    InertialUnit { name "body_orientation" }
    Accelerometer { name "body_accelerometer" }
    Gyro { name "body_gyro" }
  ]
      }
    }
  ]
}
